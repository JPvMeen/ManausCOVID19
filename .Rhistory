pull(q50_prop)
log10_IFR <- -7:0
intercept <-  -1.1828
slope <- 0.524
IFR <- 10^(intercept + slope*log10_IFR)
weighted.mean(
x = IFR[2:7],
w = data_stan_Manaus_2w_updated_strainfreq$demography[2:7]*seroprev_unadjusted
)
weighted.mean(
x = IFR,
w = data_stan_Manaus_2w_updated_strainfreq$demography*(1-susceptible_june)
)
weighted.mean(
x = IFR,
w = data_stan_Manaus_2w_updated_strainfreq$demography*(1-susceptible_october)
)
