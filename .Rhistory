manaus_2w_simp_sims_wide_q50 <- manaus_2w_simp_sims %>%
select(date, state, AGEGROUP, q50) %>%
pivot_wider(names_from = state, values_from = q50) %>%
arrange(date) %>%
group_by(AGEGROUP) %>%
mutate(N = Susceptible + Infected1 + Infected1_re + Recovered1 + Waned1 + Infected2 + Infected2_re + Recovered2 + Waned2,
total_R1 = Recovered1 + Waned1 + Infected1_re,
max_q50 = max(total_R1),
final_q50 = last(total_R1),
reinfected = max_q50 - final_q50,
p_reinfected = reinfected / max_q50 * 100,
p_remaining = final_q50 / max_q50 * 100) %>%
ungroup()
manaus_2w_simp_sims_wide_q50 #%>%
#select(AGEGROUP, final_q50, reinfected, p_reinfected, p_remaining)
manaus_2w_simp_sims_wide_q50 %>%
summarise(p_reinfected_weighted_average = sum(reinfected) / sum(max_q50))
