geom_ribbon(data = . %>% filter(state == "simulated_hospdeaths"), aes(y= cum_q50, ymin = cum_q05, ymax = cum_q95), alpha = 0.2) +
geom_line(data = . %>% filter(state == "simulated_hospdeaths"), aes(y = cum_q50), size = 0.8) +
geom_ribbon(data = . %>% filter(state == "expected_hospdeaths"), aes(y= cum_q50, ymin = cum_q05, ymax = cum_q95), alpha = 0.4) +
geom_line(data = . %>% filter(state == "expected_hospdeaths"), aes(y= cum_q50), col = "black") +
geom_point(data = . %>% filter(state == "data_hospdeaths"), aes(y=cum_q50)) +
